<?xml version="1.0" encoding="utf-8"?>
<!--
  Paket politikası:
  - Dış kaynaklar (nuget.org dahil) kapalı. Otomatik güncelleme ve ağ çağrısı yok.
  - Paketler yalnızca yerel "packages" klasöründen okunur. Bu klasörü geliştirici bir kez,
    sürümleri sabitleyerek doldurur ve packages.lock.json ile birlikte saklar.
  - Çalışma zamanında program ağa çıkmaz.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="LocalPackages" value="packages" />
  </packageSources>
</configuration>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Paket kaynakları bu projeye özeldir: bilgisayardaki (kullanıcı / şirket) NuGet ayarları devre dışı bırakılır,
  böylece paketler her bilgisayarda aynı yerden ve sabit sürümlerle iner (sürümler .csproj dosyalarında sabit).
  - Paketler yalnızca DERLEME sırasında iner; çalışan program ağa çıkmaz.
  - nuget.org'a erişim yoksa: offline-paketler.ps1 -Kullan yerel "packages-offline" kaynağını ekler ve nuget.org'u kapatır.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>

<Window
    x:Class="MuayeneKayit.Inspector.CameraWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" Background="#111111" RequestedTheme="Dark">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Üst çubuk: hangi kusur, hangi kamera -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Padding="16,10" Background="#1E1E1E">
            <TextBlock x:Name="TargetText" Foreground="White" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" Margin="0,0,16,0" />
            <ComboBox x:Name="DeviceBox" Width="320" PlaceholderText="Kamera seçin" SelectionChanged="DeviceBox_SelectionChanged" />
            <Button Content="Kameraları yenile" Click="RefreshDevices_Click" />
            <ToggleSwitch x:Name="FrameToggle" OnContent="Çerçeve açık" OffContent="Çerçeve kapalı" Toggled="FrameToggle_Toggled"
                          ToolTipService.ToolTip="Açıkken ortadaki kare, kaydedilen fotoğrafta kusur işareti olur" />
            <ToggleSwitch x:Name="AutoFocusToggle" OnContent="Otomatik odak" OffContent="Odak sabit" IsOn="True" Visibility="Collapsed" Toggled="AutoFocus_Toggled" />
            <TextBlock x:Name="ResolutionText" Foreground="#AAAAAA" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Görüntü alanı: canlı görüntü ya da çekilen fotoğrafın önizlemesi -->
        <Grid Grid.Row="1">
            <!-- Canlı görüntü (telefon kamerası gibi): iki parmakla zoom, çift dokunma 1× / 2×, dokunarak odak, tekerlekle zoom.
                 Zoom her zaman ortaya doğrudur; çekilen fotoğraf ekranda görünen alan kadar kırpılır. -->
            <Grid
                x:Name="PreviewArea"
                Background="Transparent"
                ManipulationMode="Scale"
                ManipulationDelta="PreviewArea_ManipulationDelta"
                DoubleTapped="PreviewArea_DoubleTapped"
                Tapped="PreviewArea_Tapped"
                PointerWheelChanged="PreviewArea_PointerWheelChanged"
                SizeChanged="PreviewArea_SizeChanged"
                AutomationProperties.AutomationId="PreviewArea">
                <Grid x:Name="PreviewHost" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="PreviewScale" ScaleX="1" ScaleY="1" />
                    </Grid.RenderTransform>
                    <MediaPlayerElement x:Name="Preview" AutoPlay="True" Stretch="Uniform" />
                </Grid>
                <!-- Kusur çerçevesi ve odak halkası ekranda sabittir (zoom'la büyümez): çerçeve kırpılmış fotoğraftaki işaretle örtüşür. -->
                <Canvas x:Name="FrameOverlay" IsHitTestVisible="False" />
                <Canvas x:Name="FocusOverlay" IsHitTestVisible="False" />
            </Grid>
            <Grid x:Name="ReviewHost" Visibility="Collapsed" SizeChanged="ReviewHost_SizeChanged">
                <Image x:Name="Review" Stretch="Uniform" />
                <Canvas x:Name="ReviewOverlay" IsHitTestVisible="False" />
            </Grid>
            <TextBlock
                x:Name="StatusText"
                Foreground="White"
                FontSize="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="720" />
        </Grid>

        <!-- Alt çubuk: zoom, çek / kaydet / tekrar çek -->
        <Grid Grid.Row="2" Padding="16,10" Background="#1E1E1E" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <!-- Telefon kamerası gibi hızlı zoom düğmeleri (dokunmatik için büyük); ara değerler iki parmakla. -->
                <Button x:Name="Zoom1Button" Content="1×" Tag="1" Click="ZoomPreset_Click" Width="56" Height="48" CornerRadius="24" AutomationProperties.AutomationId="Zoom1Button" />
                <Button x:Name="Zoom2Button" Content="2×" Tag="2" Click="ZoomPreset_Click" Width="56" Height="48" CornerRadius="24" AutomationProperties.AutomationId="Zoom2Button" />
                <Button x:Name="Zoom4Button" Content="4×" Tag="4" Click="ZoomPreset_Click" Width="56" Height="48" CornerRadius="24" AutomationProperties.AutomationId="Zoom4Button" />
                <TextBlock x:Name="ZoomText" Text="1.0×" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Width="48" AutomationProperties.AutomationId="ZoomText" />
                <TextBlock x:Name="FrameSizeLabel" Text="Çerçeve" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="16,0,0,0" />
                <Slider x:Name="FrameSizeSlider" Minimum="0.05" Maximum="0.9" StepFrequency="0.05" Width="180" VerticalAlignment="Center"
                        ValueChanged="FrameSize_ValueChanged" ToolTipService.ToolTip="Çerçevenin boyutu (görüntünün kısa kenarına oranı)" />
                <TextBlock x:Name="FrameSizeText" Foreground="White" VerticalAlignment="Center" Width="40" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <Button x:Name="CaptureButton" Content="Fotoğraf çek  (Boşluk)" Click="Capture_Click" IsEnabled="False" MinWidth="240" Height="56" FontSize="16" Style="{StaticResource AccentButtonStyle}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Space" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Button x:Name="SaveButton" Content="Kaydet  (Enter)" Click="Save_Click" Visibility="Collapsed" MinWidth="170" Height="56" FontSize="16" Style="{StaticResource AccentButtonStyle}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Enter" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Button x:Name="RetakeButton" Content="Tekrar çek  (Esc)" Click="Retake_Click" Visibility="Collapsed" MinWidth="170" Height="56" FontSize="16">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Escape" />
                    </Button.KeyboardAccelerators>
                </Button>
            </StackPanel>

            <TextBlock Grid.Column="2" x:Name="SavedText" Foreground="#7CD992" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Window>

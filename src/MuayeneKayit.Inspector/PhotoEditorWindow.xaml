<Window
    x:Class="MuayeneKayit.Inspector.PhotoEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F3F5F9" RequestedTheme="Light">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="Z" Invoked="Undo_Invoked" />
        </Grid.KeyboardAccelerators>

        <!-- Araçlar -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DDE2EA" BorderThickness="0,0,0,1" Padding="16,10">
            <StackPanel Spacing="8">
                <TextBlock x:Name="TargetText" FontWeight="SemiBold" Foreground="#1A3A5C" FontSize="16" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ToggleButton x:Name="BoxTool" Content="Kutu" Height="44" MinWidth="80" IsChecked="True" Click="Tool_Click" />
                    <ToggleButton x:Name="CircleTool" Content="Daire" Height="44" MinWidth="80" Click="Tool_Click" />
                    <ToggleButton x:Name="ArrowTool" Content="Ok" Height="44" MinWidth="80" Click="Tool_Click" />
                    <ComboBox x:Name="LabelBox" Height="44" MinWidth="120" VerticalAlignment="Center" ToolTipService.ToolTip="İşaretin gösterdiği kusur numarası" />
                    <Button Content="Son işareti geri al" Height="44" Click="Undo_Click" />
                    <Button Content="İşaretleri sil" Height="44" Click="ClearShapes_Click" />

                    <Border Width="1" Background="#DDE2EA" Margin="8,4" />

                    <ToggleButton x:Name="BgTool" Content="Arka plan: parçayı çerçevele" Height="44" Click="Tool_Click" />
                    <Button x:Name="BgApplyButton" Content="Arka planı kaldır" Height="44" IsEnabled="False" Click="BgApply_Click" Style="{StaticResource AccentButtonStyle}" />
                    <Button x:Name="BgRevertButton" Content="Orijinale dön" Height="44" IsEnabled="False" Click="BgRevert_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Fotoğraf ve çizim yüzeyi: Viewbox içinde, koordinatlar görüntü pikseli cinsinden -->
        <Grid Grid.Row="1" Background="#2B2B2B">
            <Viewbox Stretch="Uniform" Margin="12">
                <Grid x:Name="Surface">
                    <Image x:Name="Photo" Stretch="Fill" />
                    <Canvas
                        x:Name="Ink"
                        Background="Transparent"
                        PointerPressed="Ink_PointerPressed"
                        PointerMoved="Ink_PointerMoved"
                        PointerReleased="Ink_PointerReleased"
                        PointerCanceled="Ink_PointerReleased" />
                </Grid>
            </Viewbox>
            <ProgressRing x:Name="Busy" IsActive="False" Width="64" Height="64" />
        </Grid>

        <!-- Alt çubuk -->
        <Grid Grid.Row="2" Background="White" BorderBrush="#DDE2EA" BorderThickness="0,1,0,0" Padding="16,10" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="HintText" Grid.Column="0" TextWrapping="Wrap" Foreground="#555" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Vazgeç" Height="48" MinWidth="120" Click="Cancel_Click" />
            <Button Grid.Column="2" x:Name="SaveButton" Content="Kaydet" Height="48" MinWidth="160" IsEnabled="False" Click="Save_Click" Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</Window>

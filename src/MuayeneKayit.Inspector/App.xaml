<Application
    x:Class="MuayeneKayit.Inspector.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Tema renkleri: koyu temada okunur olmaları için Light / Dark ayrı tanımlanır. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BrandTextBrush" Color="#1A3A5C" />
                    <SolidColorBrush x:Key="WarnTextBrush" Color="#B45309" />
                    <SolidColorBrush x:Key="MrbTextBrush" Color="#6D28D9" />
                    <SolidColorBrush x:Key="ReworkTextBrush" Color="#1D4ED8" />
                    <SolidColorBrush x:Key="DoneTextBrush" Color="#15803D" />
                    <SolidColorBrush x:Key="PaneBackgroundBrush" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BrandTextBrush" Color="#9CB8DA" />
                    <SolidColorBrush x:Key="WarnTextBrush" Color="#F5B25A" />
                    <SolidColorBrush x:Key="MrbTextBrush" Color="#C4B5FD" />
                    <SolidColorBrush x:Key="ReworkTextBrush" Color="#93C5FD" />
                    <SolidColorBrush x:Key="DoneTextBrush" Color="#86EFAC" />
                    <SolidColorBrush x:Key="PaneBackgroundBrush" Color="#1C1C1C" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="BrandTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="WarnTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="MrbTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ReworkTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="DoneTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="PaneBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <x:Double x:Key="ContentDialogMaxWidth">960</x:Double>

            <!-- Kurumsal vurgu rengi (lacivert). Vurgulu butonlar ve seçimler bu rengi kullanır. -->
            <Color x:Key="SystemAccentColor">#1A3A5C</Color>
            <Color x:Key="SystemAccentColorLight1">#2C5480</Color>
            <Color x:Key="SystemAccentColorLight2">#4A73A0</Color>
            <Color x:Key="SystemAccentColorLight3">#7C9CC2</Color>
            <Color x:Key="SystemAccentColorDark1">#1A3A5C</Color>
            <Color x:Key="SystemAccentColorDark2">#132C46</Color>
            <Color x:Key="SystemAccentColorDark3">#0C1E30</Color>

            <!-- Kodla kurulan kartlar ve diyaloglar (DashboardCards, WinUiDialogService) bu stilleri kullanır; tema değişince renkler kendiliğinden güncellenir. -->
            <Style x:Key="BrandTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource BrandTextBrush}" />
            </Style>
            <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="TertiaryTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>
            <Style x:Key="WarnTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource WarnTextBrush}" />
            </Style>
            <Style x:Key="MrbTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource MrbTextBrush}" />
            </Style>
            <Style x:Key="ReworkTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource ReworkTextBrush}" />
            </Style>
            <Style x:Key="DoneTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource DoneTextBrush}" />
            </Style>
            <Style x:Key="SubtleCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <!-- Kart yüzeyi: sistem kart fırçaları, tema ve yüksek kontrastla uyumlu -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

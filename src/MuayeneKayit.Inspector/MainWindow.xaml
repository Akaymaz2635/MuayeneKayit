<Window
    x:Class="MuayeneKayit.Inspector.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <NavigationView
        x:Name="Nav"
        RequestedTheme="Light"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        PaneDisplayMode="Left"
        OpenPaneLength="190"
        SelectionChanged="Nav_SelectionChanged">

        <NavigationView.Resources>
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#FFFFFF" />
        </NavigationView.Resources>

        <NavigationView.MenuItems>
            <NavigationViewItem Content="Muayene" Tag="inspect">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Edit" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Dashboard" Tag="dash">
                <NavigationViewItem.Icon><SymbolIcon Symbol="View" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Grid Background="#F3F5F9">

            <!-- ───────── Muayene paneli ───────── -->
            <Grid x:Name="InspectPanel" Padding="20,16,20,16" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Oturum çubuğu -->
                <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16,12" BorderBrush="#DDE2EA" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Oturum" FontWeight="SemiBold" Foreground="#1A3A5C" FontSize="16" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <AutoSuggestBox x:Name="PartBox" Header="Parça no" Width="170" PlaceholderText="Yaz ya da seç" TextChanged="Suggest_TextChanged" GotFocus="Suggest_GotFocus" />
                            <AutoSuggestBox x:Name="OpBox" Header="Operasyon" Width="130" PlaceholderText="Yaz ya da seç" TextChanged="Suggest_TextChanged" GotFocus="Suggest_GotFocus" />
                            <AutoSuggestBox x:Name="SerialBox" Header="Seri no" Width="170" PlaceholderText="Yaz ya da seç" TextChanged="Suggest_TextChanged" GotFocus="Suggest_GotFocus" />
                            <TextBox x:Name="InspectorBox" Header="Muayeneci" Width="140" />
                            <Button Content="Muayene oluştur" Click="OpenSession_Click" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" />
                            <Button x:Name="ReportButton" Content="Rapor oluştur (PDF)" Click="Report_Click" VerticalAlignment="Bottom" IsEnabled="False" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <InfoBar Grid.Row="1" x:Name="Status" IsOpen="False" IsClosable="True" />

                <!-- Gövde: solda kusur listesi, sağda seçili kusur -->
                <Grid Grid.Row="2" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Kusur listesi -->
                    <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="14" BorderBrush="#DDE2EA" BorderThickness="1">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Kusurlar" FontWeight="SemiBold" Foreground="#1A3A5C" FontSize="16" />
                            <StackPanel Grid.Row="1" Spacing="8">
                                <ComboBox x:Name="DefectTypeBox" Header="Kusur tipi (yeni ve child için)" HorizontalAlignment="Stretch" />
                                <Button Content="Kusur ekle" Click="AddDefect_Click" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>
                            <ListView Grid.Row="2" x:Name="DefectList" SelectionMode="Single" SelectionChanged="DefectList_SelectionChanged" />
                        </Grid>
                    </Border>

                    <!-- Seçili kusur detayı -->
                    <ScrollViewer Grid.Column="1">
                        <StackPanel Spacing="12">

                            <!-- 1. Kusur ve ölçüm (muayene adımı) -->
                            <Border Background="White" CornerRadius="8" Padding="16" BorderBrush="#DDE2EA" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="SelectedHeader" Text="Kusur seçilmedi" FontWeight="SemiBold" Foreground="#1A3A5C" FontSize="16" />
                                    <TextBlock x:Name="SelectedSentence" Text="Soldan bir kusur ekleyin ya da seçin, ölçümleri buradan girin." TextWrapping="Wrap" Foreground="#555" />
                                    <TextBlock x:Name="DeltaText" TextWrapping="Wrap" Foreground="#B45309" FontWeight="SemiBold" Visibility="Collapsed" />
                                    <!-- Rework'teyken: ölçümler kilitli, ne yapılacağı tek bir kutuda -->
                                    <Border x:Name="AwaitBanner" Visibility="Collapsed" Background="#FFF8E1" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Padding="14,12">
                                        <StackPanel Spacing="8">
                                            <TextBlock x:Name="AwaitTitle" FontWeight="SemiBold" Foreground="#92400E" TextWrapping="Wrap" />
                                            <TextBlock x:Name="AwaitText" TextWrapping="Wrap" Foreground="#555" />
                                            <Button x:Name="ReinspectButton" Content="Rework sonrası muayene sonucunu gir" Click="ReinspectButton_Click" Style="{StaticResource AccentButtonStyle}" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel x:Name="MeasureArea" Spacing="10">
                                    <TextBlock Text="Ölçümler" FontWeight="SemiBold" Margin="0,6,0,0" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBox x:Name="DepthBox" Header="Derinlik (mm)" Width="130" />
                                        <TextBox x:Name="WidthBox" Header="Genişlik (mm)" Width="130" />
                                        <TextBox x:Name="LengthBox" Header="Uzunluk (mm)" Width="130" />
                                        <TextBox x:Name="RadiusBox" Header="Yarıçap (mm)" Width="130" />
                                        <TextBox x:Name="AngleBox" Header="Açı (°)" Width="110" />
                                        <TextBox x:Name="ColorBox" Header="Renk" Width="150" />
                                    </StackPanel>
                                    <TextBox x:Name="NotesBox" Header="Not" AcceptsReturn="True" Height="60" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Content="Ölçümleri kaydet" Click="SaveMeasurements_Click" x:Name="SaveMeasButton" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" />
                                        <Button Content="Void (yanlış giriş)" Click="VoidButton_Click" x:Name="VoidButton" Visibility="Collapsed" />
                                    </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 2. Fotoğraflar -->
                            <Border Background="White" CornerRadius="8" Padding="16" BorderBrush="#DDE2EA" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Fotoğraflar" FontWeight="SemiBold" Foreground="#1A3A5C" FontSize="16" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Content="Kamera ile çek" Click="CameraButton_Click" x:Name="CameraButton" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" />
                                        <Button Content="Dosyadan ekle (JPG / PNG)" Click="AddPhoto_Click" x:Name="AddPhotoButton" IsEnabled="False" />
                                    </StackPanel>
                                    <TextBlock x:Name="PhotoEmpty" Text="Henüz fotoğraf yok." Foreground="#888" />
                                    <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="PhotoPanel" Orientation="Horizontal" Spacing="10" Padding="0,0,0,8" />
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                            <!-- 3. Mühendis kararı: muayene sonrası, varsayılan kapalı -->
                            <Expander x:Name="DecisionExpander" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Expander.Header>
                                    <TextBlock Text="Disposition" FontWeight="SemiBold" Foreground="#1A3A5C" FontSize="16" Padding="0,10" />
                                </Expander.Header>
                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="DecisionHint" Text="Karar vermek için listeden bir kusur seçin." Foreground="#666" FontSize="12" TextWrapping="Wrap" />
                                    <ComboBox x:Name="DecisionCombo" Header="Karar (seçince ne olacağı açıklanır, onaylamadan kaydedilmez)" PlaceholderText="Karar seçin" Width="420" SelectionChanged="DecisionCombo_SelectionChanged" />
                                    <StackPanel x:Name="UndoPanel" Orientation="Horizontal" Spacing="10" Visibility="Collapsed">
                                        <Button x:Name="UndoButton" Content="Son kararı geri al" Click="Undo_Click" />
                                        <TextBlock x:Name="UndoText" Foreground="#666" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander>

                            <!-- 4. Karar geçmişi: varsayılan kapalı -->
                            <Expander x:Name="HistoryExpander" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Expander.Header>
                                    <StackPanel Padding="0,8">
                                        <TextBlock x:Name="HistoryHeader" Text="Karar ve düzeltme geçmişi" FontWeight="SemiBold" Foreground="#1A3A5C" FontSize="16" />
                                        <TextBlock Text="Kayıtlar silinmez. Rework turları, yeniden açmalar ve ölçüm düzeltmeleri burada." Foreground="#666" FontSize="12" />
                                    </StackPanel>
                                </Expander.Header>
                                <ListView x:Name="HistoryList" SelectionMode="None" MaxHeight="260" />
                            </Expander>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Button Grid.Row="3" Content="Muayeneyi tamamla" Click="Complete_Click" HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" />
            </Grid>

            <!-- ───────── Dashboard paneli ───────── -->
            <Grid x:Name="DashPanel" Padding="20,16,20,16" RowSpacing="12" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Filtreler -->
                <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16,12" BorderBrush="#DDE2EA" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Dashboard" FontWeight="SemiBold" Foreground="#1A3A5C" FontSize="18" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <Button Content="Yenile" Click="RefreshIndex_Click" Style="{StaticResource AccentButtonStyle}" />
                            <Button Content="Filtreleri temizle" Click="ClearFilters_Click" />
                            <Button Content="Denetim kaydını doğrula" Click="VerifyAudit_Click" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBox x:Name="FilterPartBox" Header="Parça no" Width="160" PlaceholderText="Tümü" TextChanged="FilterText_Changed" />
                            <TextBox x:Name="FilterOpBox" Header="Operasyon" Width="120" PlaceholderText="Tümü" TextChanged="FilterText_Changed" />
                            <TextBox x:Name="SerialFilterBox" Header="Seri no" Width="160" PlaceholderText="Tümü" TextChanged="FilterText_Changed" />
                            <ComboBox x:Name="FilterTypeBox" Header="Hata tipi" Width="190" SelectionChanged="FilterSelection_Changed" />
                            <ComboBox x:Name="FilterStateBox" Header="Durum" Width="260" SelectionChanged="FilterSelection_Changed" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <InfoBar Grid.Row="1" x:Name="DashInfo" IsOpen="False" IsClosable="True" />

                <!-- Özet kartları -->
                <StackPanel Grid.Row="2" x:Name="SummaryCards" Orientation="Horizontal" Spacing="12" />

                <!-- Sonuçlar -->
                <ScrollViewer Grid.Row="3">
                    <StackPanel x:Name="ResultsPanel" Spacing="8" Padding="0,0,12,0" />
                </ScrollViewer>
            </Grid>

        </Grid>
    </NavigationView>
</Window>

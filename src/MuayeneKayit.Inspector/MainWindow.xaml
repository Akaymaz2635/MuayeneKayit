<Window
    x:Class="MuayeneKayit.Inspector.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MuayeneKayit.Inspector">

    <NavigationView
        x:Name="Nav"
        RequestedTheme="Light"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        PaneDisplayMode="Left"
        OpenPaneLength="190"
        SelectionChanged="Nav_SelectionChanged">

        <NavigationView.Resources>
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#FFFFFF" />
        </NavigationView.Resources>

        <NavigationView.MenuItems>
            <NavigationViewItem Content="Muayene" Tag="inspect">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Edit" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Dashboard" Tag="dash">
                <NavigationViewItem.Icon><SymbolIcon Symbol="View" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">

            <!-- ───────── Muayene paneli ───────── -->
            <Grid x:Name="InspectPanel" Padding="24,16,24,16" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <InfoBar Grid.Row="0" x:Name="Status" IsOpen="False" IsClosable="True" AutomationProperties.AutomationId="StatusInfoBar" />

                <!-- A) Muayene seçimi: oturum açık değilken ekranda yalnızca bu kart -->
                <Grid Grid.Row="1" x:Name="StartPanel">
                    <Border Style="{StaticResource CardStyle}" Width="600" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Muayene" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="Parça, operasyon ve seri numarasını girin. Kayıt varsa açılır, yoksa yeni muayene oluşturulur." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Grid ColumnSpacing="12" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <AutoSuggestBox x:Name="PartBox" Header="Parça no" PlaceholderText="Yaz ya da seç" TextChanged="Suggest_TextChanged" GotFocus="Suggest_GotFocus" AutomationProperties.AutomationId="PartBox" />
                                <AutoSuggestBox x:Name="OpBox" Grid.Column="1" Header="Operasyon" PlaceholderText="Yaz ya da seç" TextChanged="Suggest_TextChanged" GotFocus="Suggest_GotFocus" AutomationProperties.AutomationId="OpBox" />
                                <AutoSuggestBox x:Name="SerialBox" Grid.Row="1" Header="Seri no" PlaceholderText="Yaz ya da seç" TextChanged="Suggest_TextChanged" GotFocus="Suggest_GotFocus" AutomationProperties.AutomationId="SerialBox" />
                                <TextBox x:Name="InspectorBox" Grid.Row="1" Grid.Column="1" Header="Muayeneci" PlaceholderText="Adınız" AutomationProperties.AutomationId="InspectorBox" />
                            </Grid>
                            <Button Content="Muayene oluştur" Click="OpenSession_Click" Height="48" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="OpenSessionButton" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- B) Çalışma alanı: oturum açıkken -->
                <Grid Grid.Row="1" x:Name="WorkPanel" RowSpacing="12" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Oturum başlığı -->
                    <Border Style="{StaticResource CardStyle}" Padding="20,12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="SessionTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock x:Name="SessionSub" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Click="ChangeSession_Click" AutomationProperties.AutomationId="ChangeSessionButton" AutomationProperties.Name="Başka muayene" ToolTipService.ToolTip="Başka bir parça / seri aç">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8AB;" FontSize="14" />
                                        <TextBlock Text="Başka muayene" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ReportButton" Click="Report_Click" IsEnabled="False" AutomationProperties.AutomationId="ReportButton" AutomationProperties.Name="Rapor (PDF)">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE749;" FontSize="14" />
                                        <TextBlock Text="Rapor (PDF)" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CompleteButton" Click="Complete_Click" AutomationProperties.AutomationId="CompleteButton" AutomationProperties.Name="Muayeneyi tamamla">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE73E;" FontSize="14" />
                                        <TextBlock Text="Muayeneyi tamamla" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Kusur listesi -->
                        <Border Style="{StaticResource CardStyle}" Padding="0,14,0,8">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="DefectCountText" Text="Kusurlar" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="16,0" />
                                <Button x:Name="AddDefectButton" Grid.Row="1" HorizontalAlignment="Stretch" Height="44" Margin="16,0" AutomationProperties.AutomationId="AddDefectButton" AutomationProperties.Name="Kusur ekle">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                                        <TextBlock Text="Kusur ekle" />
                                    </StackPanel>
                                    <Button.Flyout>
                                        <Flyout x:Name="AddDefectFlyout" Placement="Bottom">
                                            <StackPanel Spacing="12" Width="280">
                                                <ComboBox x:Name="DefectTypeBox" Header="Kusur tipi" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="DefectTypeBox" />
                                                <Button Content="Ekle" Click="AddDefect_Click" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="ConfirmAddDefectButton" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <TextBlock x:Name="DefectListEmpty" Grid.Row="2" Margin="16,8" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Henüz kusur yok. Parçada kusur bulduysanız 'Kusur ekle' ile başlayın; kusur yoksa muayeneyi tamamlayabilirsiniz." />
                                <ListView Grid.Row="2" x:Name="DefectList" SelectionMode="Single" SelectionChanged="DefectList_SelectionChanged" AutomationProperties.AutomationId="DefectList">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:DefectItem">
                                            <Grid Padding="0,10" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="44" Height="44" CornerRadius="22" Background="{x:Bind StateBackground}" VerticalAlignment="Top">
                                                    <TextBlock Text="{x:Bind Number}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{x:Bind StateForeground}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="3">
                                                    <TextBlock Text="{x:Bind Type}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Border Background="{x:Bind StateBackground}" CornerRadius="4" Padding="6,1">
                                                            <TextBlock Text="{x:Bind StateText}" FontSize="12" Foreground="{x:Bind StateForeground}" />
                                                        </Border>
                                                        <TextBlock Text="{x:Bind PhotoText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind NextStep}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>

                        <!-- Seçili kusur -->
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="0">
                            <Grid>
                                <!-- Kusur seçilmediğinde -->
                                <StackPanel x:Name="DetailEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="420">
                                    <FontIcon Glyph="&#xE8FD;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="Kusur seçilmedi" HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Soldaki listeden bir kusur seçin ya da 'Kusur ekle' ile yeni kusur girin." TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <Grid x:Name="DetailContent" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Başlık: kusur, durum, sıradaki adım -->
                                    <StackPanel Padding="20,16,20,8" Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock x:Name="SelectedHeader" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                                            <Border x:Name="StateChip" CornerRadius="4" Padding="10,3" VerticalAlignment="Center">
                                                <TextBlock x:Name="StateChipText" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                        <Border x:Name="NextStepBox" Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}" CornerRadius="6" Padding="12,8">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource SystemFillColorAttentionBrush}" />
                                                <TextBlock x:Name="NextStepText" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock x:Name="SelectedSentence" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <!-- Adımlar -->
                                    <SelectorBar Grid.Row="1" x:Name="DetailTabs" Margin="12,0" SelectionChanged="DetailTabs_SelectionChanged" AutomationProperties.AutomationId="DetailTabs">
                                        <SelectorBarItem x:Name="MeasureTabItem" Text="1. Ölçüm" />
                                        <SelectorBarItem x:Name="PhotoTabItem" Text="2. Fotoğraflar" />
                                        <SelectorBarItem x:Name="DecisionTabItem" Text="3. Disposition" />
                                        <SelectorBarItem x:Name="HistoryTabItem" Text="Geçmiş" />
                                    </SelectorBar>

                                    <ScrollViewer Grid.Row="2" Padding="20,12,20,20">
                                        <Grid>
                                            <!-- 1. Ölçüm -->
                                            <StackPanel x:Name="MeasureTab" Spacing="12">
                                                <TextBlock x:Name="DeltaText" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontWeight="SemiBold" Visibility="Collapsed" />

                                                <!-- Rework'teyken: ölçümler kilitli, ne yapılacağı tek bir kutuda -->
                                                <Border x:Name="AwaitBanner" Visibility="Collapsed" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" CornerRadius="6" Padding="16,14">
                                                    <StackPanel Spacing="8">
                                                        <TextBlock x:Name="AwaitTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                                        <TextBlock x:Name="AwaitText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <Button x:Name="ReinspectButton" Content="Rework sonrası muayene sonucunu gir" Click="ReinspectButton_Click" Height="44" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="ReinspectButton" />
                                                    </StackPanel>
                                                </Border>

                                                <StackPanel x:Name="MeasureArea" Spacing="12">
                                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                                        <TextBox x:Name="DepthBox" Header="Derinlik (mm)" Width="130" InputScope="Number" AutomationProperties.AutomationId="DepthBox" />
                                                        <TextBox x:Name="WidthBox" Header="Genişlik (mm)" Width="130" InputScope="Number" AutomationProperties.AutomationId="WidthBox" />
                                                        <TextBox x:Name="LengthBox" Header="Uzunluk (mm)" Width="130" InputScope="Number" AutomationProperties.AutomationId="LengthBox" />
                                                        <TextBox x:Name="RadiusBox" Header="Yarıçap (mm)" Width="130" InputScope="Number" AutomationProperties.AutomationId="RadiusBox" />
                                                        <TextBox x:Name="AngleBox" Header="Açı (°)" Width="130" InputScope="Number" AutomationProperties.AutomationId="AngleBox" />
                                                        <TextBox x:Name="ColorBox" Header="Renk" Width="150" AutomationProperties.AutomationId="ColorBox" />
                                                    </StackPanel>
                                                    <TextBox x:Name="NotesBox" Header="Not" AcceptsReturn="True" Height="72" TextWrapping="Wrap" AutomationProperties.AutomationId="NotesBox" />
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <CheckBox x:Name="HighMetalBox" Content="High metal mevcut" VerticalAlignment="Center" MinWidth="0" Margin="0,0,6,0"
                                                                  AutomationProperties.AutomationId="HighMetalBox"
                                                                  ToolTipService.ToolTip="Yan kusur: pozitif metal yığılması. Cümlede 'Dent with high metal' olarak yazılır." />
                                                        <Button Content="Ölçümleri kaydet" Click="SaveMeasurements_Click" x:Name="SaveMeasButton" IsEnabled="False" Height="44" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="SaveMeasButton" />
                                                        <Button Content="Void (yanlış giriş)" Click="VoidButton_Click" x:Name="VoidButton" Height="44" Visibility="Collapsed" AutomationProperties.AutomationId="VoidButton" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- 2. Fotoğraflar -->
                                            <StackPanel x:Name="PhotoTab" Spacing="12" Visibility="Collapsed">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <Button Click="CameraButton_Click" x:Name="CameraButton" IsEnabled="False" Height="44" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="CameraButton" AutomationProperties.Name="Kamera ile çek">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <FontIcon Glyph="&#xE722;" FontSize="14" />
                                                            <TextBlock Text="Kamera ile çek" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Click="AddPhoto_Click" x:Name="AddPhotoButton" IsEnabled="False" Height="44" AutomationProperties.AutomationId="AddPhotoButton" AutomationProperties.Name="Dosyadan ekle">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                                            <TextBlock Text="Dosyadan ekle" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                                <TextBlock x:Name="PhotoEmpty" Text="Henüz fotoğraf yok. Kusuru kamerayla çekin; sonra 'İşaretle' ile kusur numarasını fotoğrafın üzerine koyun." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <VariableSizedWrapGrid x:Name="PhotoPanel" Orientation="Horizontal" ItemWidth="208" ItemHeight="250" />
                                            </StackPanel>

                                            <!-- 3. Disposition -->
                                            <StackPanel x:Name="DecisionTab" Spacing="12" Visibility="Collapsed">
                                                <TextBlock x:Name="DecisionHint" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <ComboBox x:Name="DecisionCombo" Header="Karar (seçince ne olacağı açıklanır, onaylamadan kaydedilmez)" PlaceholderText="Karar seçin" Width="420" SelectionChanged="DecisionCombo_SelectionChanged" AutomationProperties.AutomationId="DecisionCombo" />
                                                <StackPanel x:Name="UndoPanel" Orientation="Horizontal" Spacing="10" Visibility="Collapsed">
                                                    <Button x:Name="UndoButton" Click="Undo_Click" AutomationProperties.AutomationId="UndoButton" AutomationProperties.Name="Son kararı geri al">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                                                            <TextBlock Text="Son kararı geri al" />
                                                        </StackPanel>
                                                    </Button>
                                                    <TextBlock x:Name="UndoText" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Geçmiş -->
                                            <StackPanel x:Name="HistoryTab" Spacing="8" Visibility="Collapsed">
                                                <TextBlock Text="Kararlar ve ölçüm düzeltmeleri, eskiden yeniye." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <ListView x:Name="HistoryList" SelectionMode="None" />
                                            </StackPanel>
                                        </Grid>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ───────── Dashboard paneli ───────── -->
            <Grid x:Name="DashPanel" Padding="20,16,20,16" RowSpacing="12" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Filtreler -->
                <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16,12" BorderBrush="#DDE2EA" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Dashboard" FontWeight="SemiBold" Foreground="#1A3A5C" FontSize="18" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <Button Content="Yenile" Click="RefreshIndex_Click" Style="{StaticResource AccentButtonStyle}" />
                            <Button Content="Filtreleri temizle" Click="ClearFilters_Click" />
                            <Button Content="Denetim kaydını doğrula" Click="VerifyAudit_Click" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBox x:Name="FilterPartBox" Header="Parça no" Width="160" PlaceholderText="Tümü" TextChanged="FilterText_Changed" />
                            <TextBox x:Name="FilterOpBox" Header="Operasyon" Width="120" PlaceholderText="Tümü" TextChanged="FilterText_Changed" />
                            <TextBox x:Name="SerialFilterBox" Header="Seri no" Width="160" PlaceholderText="Tümü" TextChanged="FilterText_Changed" />
                            <ComboBox x:Name="FilterTypeBox" Header="Hata tipi" Width="190" SelectionChanged="FilterSelection_Changed" />
                            <ComboBox x:Name="FilterStateBox" Header="Durum" Width="260" SelectionChanged="FilterSelection_Changed" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <InfoBar Grid.Row="1" x:Name="DashInfo" IsOpen="False" IsClosable="True" />

                <!-- Özet kartları -->
                <StackPanel Grid.Row="2" x:Name="SummaryCards" Orientation="Horizontal" Spacing="12" />

                <!-- Sonuçlar -->
                <ScrollViewer Grid.Row="3">
                    <StackPanel x:Name="ResultsPanel" Spacing="8" Padding="0,0,12,0" />
                </ScrollViewer>
            </Grid>

        </Grid>
    </NavigationView>
</Window>

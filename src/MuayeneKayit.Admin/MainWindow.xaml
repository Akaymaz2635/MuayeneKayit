<Window
    x:Class="MuayeneKayit.Admin.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pres="using:MuayeneKayit.Presentation">

    <Grid Background="#F3F5F9" RequestedTheme="Light">

        <!-- ───────── PIN girişi ───────── -->
        <Grid x:Name="LoginPanel" Visibility="{x:Bind Shell.IsLoggedOut, Mode=OneWay}">
            <Border Background="White" CornerRadius="10" Padding="32" BorderBrush="#DDE2EA" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">
                <StackPanel Spacing="14">
                    <TextBlock Text="MuayeneKayit · Admin" FontSize="22" FontWeight="SemiBold" Foreground="#1A3A5C" />
                    <TextBlock x:Name="LoginHint" Text="{x:Bind Shell.Login.Hint, Mode=OneWay}" TextWrapping="Wrap" Foreground="#555" />
                    <PasswordBox x:Name="PinBox" Password="{x:Bind Shell.Login.Pin, Mode=TwoWay}" Header="PIN" MaxLength="12" InputScope="NumericPin" KeyDown="PinBox_KeyDown" />
                    <PasswordBox x:Name="PinRepeatBox" Password="{x:Bind Shell.Login.PinRepeat, Mode=TwoWay}" Header="PIN (tekrar)" MaxLength="12" InputScope="NumericPin" Visibility="{x:Bind Shell.Login.IsFirstRun, Mode=OneWay}" KeyDown="PinBox_KeyDown" />
                    <Button x:Name="LoginButton" Content="{x:Bind Shell.Login.ButtonText, Mode=OneWay}" Click="{x:Bind Shell.Login.Login}" HorizontalAlignment="Stretch" Height="44" Style="{StaticResource AccentButtonStyle}" />
                    <TextBlock x:Name="LoginError" Text="{x:Bind Shell.Login.Error, Mode=OneWay}" Foreground="#B91C1C" TextWrapping="Wrap" />
                    <TextBlock x:Name="LoginRoot" Text="{x:Bind Shell.Login.RootText, Mode=OneWay}" Foreground="#888" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ───────── Admin paneli ───────── -->
        <NavigationView
            x:Name="Nav"
            Visibility="{x:Bind Shell.IsLoggedIn, Mode=OneWay}"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="200"
            SelectionChanged="Nav_SelectionChanged">

            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#FFFFFF" />
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#FFFFFF" />
                <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#FFFFFF" />
            </NavigationView.Resources>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Kayıtlar" Tag="records">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="List" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Kusur tipleri" Tag="types">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Edit" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Karar açıklamaları" Tag="texts">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Comment" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Bakım" Tag="maint">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Repair" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Ayarlar" Tag="settings">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Kilitle" Tag="lock">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="ProtectedDocument" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid Padding="20,16" RowSpacing="12" Background="#F3F5F9">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <InfoBar Grid.Row="0" x:Name="Status" IsOpen="False" IsClosable="True" />

                <!-- Kayıtlar: tüm seriler -->
                <Grid Grid.Row="1" x:Name="RecordsPanel" RowSpacing="12" Visibility="{x:Bind Shell.IsRecordsPage, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="White" CornerRadius="8" Padding="16,12" BorderBrush="#DDE2EA" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="Tüm kayıtlar" FontWeight="SemiBold" Foreground="#1A3A5C" FontSize="18" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <Button Content="Yenile" Click="{x:Bind Shell.Records.Refresh}" Style="{StaticResource AccentButtonStyle}" />
                                <Button Content="CSV olarak dışa aktar" Click="ExportCsv_Click" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBox x:Name="FPart" Text="{x:Bind Shell.Records.PartFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Parça no" Width="150" PlaceholderText="Tümü" />
                                <TextBox x:Name="FOp" Text="{x:Bind Shell.Records.OperationFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Operasyon" Width="120" PlaceholderText="Tümü" />
                                <TextBox x:Name="FSerial" Text="{x:Bind Shell.Records.SerialFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Seri no" Width="150" PlaceholderText="Tümü" />
                                <ComboBox x:Name="FType" ItemsSource="{x:Bind Shell.Records.TypeOptions, Mode=OneWay}" SelectedItem="{x:Bind Shell.Records.TypeFilter, Mode=TwoWay}" Header="Hata tipi" Width="180" />
                                <ComboBox x:Name="FState" ItemsSource="{x:Bind Shell.Records.StateOptions}" DisplayMemberPath="Label" SelectedItem="{x:Bind Shell.Records.StateFilter, Mode=TwoWay}" Header="Durum" Width="240" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Row="1" x:Name="SummaryCards" Orientation="Horizontal" Spacing="12" />
                    <ScrollViewer Grid.Row="2">
                        <StackPanel x:Name="ResultsPanel" Spacing="8" Padding="0,0,12,0" />
                    </ScrollViewer>
                </Grid>

                <!-- Kusur tipi şablonları -->
                <Grid Grid.Row="1" x:Name="TypesPanel" ColumnSpacing="12" Visibility="{x:Bind Shell.IsTypesPage, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="White" CornerRadius="8" Padding="14" BorderBrush="#DDE2EA" BorderThickness="1">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Kusur tipleri" FontWeight="SemiBold" Foreground="#1A3A5C" FontSize="16" />
                            <ListView Grid.Row="1" x:Name="TypeList" SelectionMode="Single" ItemsSource="{x:Bind Shell.Types.Items, Mode=OneWay}" SelectedIndex="{x:Bind Shell.Types.SelectedIndex, Mode=TwoWay}" />
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                                <Button Content="Yeni tip" Click="{x:Bind Shell.Types.Add}" />
                                <Button Content="Yukarı" Click="{x:Bind Shell.Types.MoveUp}" />
                                <Button Content="Aşağı" Click="{x:Bind Shell.Types.MoveDown}" />
                                <Button Content="Sil" Click="DeleteType_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="16" BorderBrush="#DDE2EA" BorderThickness="1" VerticalAlignment="Top">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Şablon" FontWeight="SemiBold" Foreground="#1A3A5C" FontSize="16" />
                            <TextBlock Text="Muayene ekranında bu tip için yalnızca işaretli ölçüm alanları gösterilir. Spec adı yeni kusura varsayılan olarak yazılır." TextWrapping="Wrap" Foreground="#666" FontSize="12" />
                            <TextBox x:Name="TypeName" Text="{x:Bind Shell.Types.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Ad" Width="320" HorizontalAlignment="Left" MaxLength="40" />
                            <TextBox x:Name="TypeSpec" Text="{x:Bind Shell.Types.SpecName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Spec adı (isteğe bağlı)" Width="320" HorizontalAlignment="Left" MaxLength="60" />
                            <TextBlock Text="Ölçüm alanları" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <CheckBox x:Name="FieldDepth" MinWidth="0" Margin="0,0,12,0" IsChecked="{x:Bind Shell.Types.FieldDepth, Mode=TwoWay}" Content="Derinlik" />
                                <CheckBox x:Name="FieldWidth" MinWidth="0" Margin="0,0,12,0" IsChecked="{x:Bind Shell.Types.FieldWidth, Mode=TwoWay}" Content="Genişlik" />
                                <CheckBox x:Name="FieldLength" MinWidth="0" Margin="0,0,12,0" IsChecked="{x:Bind Shell.Types.FieldLength, Mode=TwoWay}" Content="Uzunluk" />
                                <CheckBox x:Name="FieldRadius" MinWidth="0" Margin="0,0,12,0" IsChecked="{x:Bind Shell.Types.FieldRadius, Mode=TwoWay}" Content="Çap" />
                                <CheckBox x:Name="FieldAngle" MinWidth="0" Margin="0,0,12,0" IsChecked="{x:Bind Shell.Types.FieldAngle, Mode=TwoWay}" Content="Açı" />
                                <CheckBox x:Name="FieldColor" MinWidth="0" Margin="0,0,12,0" IsChecked="{x:Bind Shell.Types.FieldColor, Mode=TwoWay}" Content="Renk" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="Şablonu uygula" Click="{x:Bind Shell.Types.Apply}" />
                                <Button Content="Tümünü ortak alana kaydet" Click="{x:Bind Shell.Types.Save}" Style="{StaticResource AccentButtonStyle}" />
                                <Button Content="Varsayılanlara dön" Click="ResetTypes_Click" />
                            </StackPanel>
                            <TextBlock x:Name="TypesDirty" Text="{x:Bind Shell.Types.DirtyText, Mode=OneWay}" Foreground="#B45309" FontSize="12" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Karar açıklamaları -->
                <Grid Grid.Row="1" x:Name="TextsPanel" RowSpacing="12" Visibility="{x:Bind Shell.IsTextsPage, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="White" CornerRadius="8" Padding="16,12" BorderBrush="#DDE2EA" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="Karar açıklamaları" FontWeight="SemiBold" Foreground="#1A3A5C" FontSize="18" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <Button Content="Ortak alana kaydet" Click="{x:Bind Shell.Texts.Save}" Style="{StaticResource AccentButtonStyle}" />
                                <Button Content="Tümünü varsayılana döndür" Click="ResetTexts_Click" />
                            </StackPanel>
                            <TextBlock Text="Inspector bir karar seçince açılan pencerede bu açıklama gösterilir. Kararın ne yapacağını ve sonra ne yapılacağını yazın (en fazla 600 karakter)." TextWrapping="Wrap" Foreground="#666" FontSize="12" />
                            <TextBlock x:Name="TextsDirty" Text="{x:Bind Shell.Texts.DirtyText, Mode=OneWay}" Foreground="#B45309" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl x:Name="TextsList" ItemsSource="{x:Bind Shell.Texts.Items, Mode=OneWay}" Padding="0,0,12,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="pres:DecisionTextItem">
                                    <Border Background="#FFFFFF" BorderBrush="#DDE2EA" BorderThickness="1" CornerRadius="8" Padding="14,10,14,12">
                                        <StackPanel Spacing="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" Foreground="#1A3A5C" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Content="Varsayılan" Click="{x:Bind ResetOne}" />
                                            </Grid>
                                            <TextBox Text="{x:Bind Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxLength="{x:Bind MaxLength}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Bakım -->
                <Grid Grid.Row="1" x:Name="MaintPanel" RowSpacing="12" Visibility="{x:Bind Shell.IsMaintenancePage, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="White" CornerRadius="8" Padding="16" BorderBrush="#DDE2EA" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Index ve denetim" FontWeight="SemiBold" Foreground="#1A3A5C" FontSize="16" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="Index'i yeniden oluştur" Click="{x:Bind Shell.Maintenance.RebuildIndex}" />
                                <Button Content="Denetim zincirini doğrula" Click="{x:Bind Shell.Maintenance.VerifyAudit}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" BorderBrush="#DDE2EA" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Eski kilitler" FontWeight="SemiBold" Foreground="#1A3A5C" FontSize="16" />
                            <TextBlock Text="Program çökerse ya da ağ koparsa kilit dosyası kalabilir. 10 dakikadan eski kilitler burada listelenir; yalnızca onlar silinebilir." TextWrapping="Wrap" Foreground="#666" FontSize="12" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="Kilitleri tara" Click="{x:Bind Shell.Maintenance.ScanLocks}" />
                                <Button Content="Seçili kilidi sil" Click="RemoveLock_Click" />
                            </StackPanel>
                            <ListView x:Name="LockList" SelectionMode="Single" MaxHeight="160" ItemsSource="{x:Bind Shell.Maintenance.StaleLocks, Mode=OneWay}" SelectedItem="{x:Bind Shell.Maintenance.SelectedLock, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="16" BorderBrush="#DDE2EA" BorderThickness="1">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Son 300 denetim kaydı" FontWeight="SemiBold" Foreground="#1A3A5C" FontSize="16" />
                            <ListView Grid.Row="1" x:Name="AuditList" SelectionMode="None" ItemsSource="{x:Bind Shell.Maintenance.AuditLines, Mode=OneWay}" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- Ayarlar -->
                <StackPanel Grid.Row="1" x:Name="SettingsPanel" Spacing="12" Visibility="{x:Bind Shell.IsSettingsPage, Mode=OneWay}">
                    <Border Background="White" CornerRadius="8" Padding="16" BorderBrush="#DDE2EA" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Ortak alan" FontWeight="SemiBold" Foreground="#1A3A5C" FontSize="16" />
                            <TextBlock Text="Bu admin uygulamasının kullandığı kök klasör. Muayene uygulamalarında aynı yol, exe'nin yanındaki MuayeneKayit.settings.json dosyasına yazılmalıdır." TextWrapping="Wrap" Foreground="#666" FontSize="12" />
                            <TextBox x:Name="RootBox" Text="{x:Bind Shell.Settings.RootText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Kök klasör (ör. \\sunucu\Muayene)" Width="520" HorizontalAlignment="Left" />
                            <Button Content="Kaydet ve yeniden bağlan" Click="{x:Bind Shell.Settings.SaveRoot}" Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="8" Padding="16" BorderBrush="#DDE2EA" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Inspector kimliği" FontWeight="SemiBold" Foreground="#1A3A5C" FontSize="16" />
                            <TextBlock Text="Açıkken Inspector adı elle yazılmaz; muayene bilgisayarında Windows'a giriş yapan kullanıcıdan alınır (sicil no ve Active Directory'deki ad, ör. 'Ali Kaymaz (12345)'). Tüm muayene bilgisayarlarına uygulanır." TextWrapping="Wrap" Foreground="#666" FontSize="12" />
                            <ToggleSwitch x:Name="WindowsUserSwitch" IsOn="{x:Bind Shell.Settings.UseWindowsUser, Mode=TwoWay}" OnContent="Windows oturumundan al" OffContent="Elle yazılır" AutomationProperties.AutomationId="WindowsUserSwitch" />
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="8" Padding="16" BorderBrush="#DDE2EA" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Admin PIN'i değiştir" FontWeight="SemiBold" Foreground="#1A3A5C" FontSize="16" />
                            <PasswordBox x:Name="OldPin" Password="{x:Bind Shell.Settings.OldPin, Mode=TwoWay}" Header="Mevcut PIN" Width="240" HorizontalAlignment="Left" MaxLength="12" />
                            <PasswordBox x:Name="NewPin" Password="{x:Bind Shell.Settings.NewPin, Mode=TwoWay}" Header="Yeni PIN (6-12 rakam)" Width="240" HorizontalAlignment="Left" MaxLength="12" />
                            <PasswordBox x:Name="NewPinRepeat" Password="{x:Bind Shell.Settings.NewPinRepeat, Mode=TwoWay}" Header="Yeni PIN (tekrar)" Width="240" HorizontalAlignment="Left" MaxLength="12" />
                            <Button Content="PIN'i değiştir" Click="{x:Bind Shell.Settings.ChangePin}" Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </NavigationView>
    </Grid>
</Window>

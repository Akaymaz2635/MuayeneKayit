<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>MuayeneKayit.Admin</RootNamespace>
    <AssemblyName>MuayeneKayit.Admin</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- Visual Studio'da seçilen platform (x64 / ARM64) hedef mimariyi belirler; komut satırındaki -r önceliklidir. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Paketlenmemiş (unpackaged) çalıştırma: Windows App SDK çalışma zamanı çıktıya dahil edilir. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- Otomatik güncelleme yok, dağıtım yalnızca bu çıktı klasörüyle yapılır. -->
    <EnableMsixTooling>false</EnableMsixTooling>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- Geliştirme ayarı (demo klasörü) yalnızca derleme çıktısına gider. Yayına örnek dosya girer: kurulumdaki
         gerçek ayar (ortak klasör yolu) güncellemede ezilmez. -->
    <None Update="MuayeneKayit.settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
    <None Update="MuayeneKayit.settings.example.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MuayeneKayit.Core\MuayeneKayit.Core.csproj" />
    <ProjectReference Include="..\MuayeneKayit.Presentation\MuayeneKayit.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9169" />
  </ItemGroup>

  <!--
    Paketlenmemiş WinUI yayınında derlenmiş XAML (.xbf) ve uygulama kaynak dizini (.pri)
    yayın klasörüne kopyalanmıyor; bunlar olmadan uygulama açılışta çöküyor.
  -->
  <Target Name="CopyXamlArtifactsToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_XamlPublishArtifacts Include="$(OutDir)*.xbf;$(OutDir)$(TargetName).pri" />
    </ItemGroup>
    <Copy SourceFiles="@(_XamlPublishArtifacts)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
